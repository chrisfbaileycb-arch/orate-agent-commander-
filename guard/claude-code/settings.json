{
  "env": {
    "COMMANDER_URL": "https://commander.example.com",
    "COMMANDER_MISSION": "msn_REPLACE_WITH_YOUR_MISSION_ID"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/ABSOLUTE/PATH/TO/agent-commander/dist/guard/claude-hook.js\" || exit 2",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
