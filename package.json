{
  "name": "orator-ai-forge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "npm run typecheck && vite build && npm run build:guard",
    "build:guard": "vite build -c vite.guard.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "demo": "tsx scripts/commander-demo.ts",
    "guard:settings": "node dist/guard/claude-hook.js --print-settings"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lucide-react": "^1.50.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
