# ORATOR · Agent Commander — environment. Copy to .env and fill in. Nothing here is a real secret.
# A blank value is the same as unset.

# ---- Listener ---------------------------------------------------------------------------------
PORT=3000
# Default is 0.0.0.0 (what AI Studio and containers need). Set 127.0.0.1 to listen on this machine only.
HOST=
# Set NODE_ENV=production for any real deployment.
NODE_ENV=

# ---- Operator cockpit access -------------------------------------------------------------------
# The cockpit (the HUD and every control) and the live ledger are locked behind a session. Visitors can
# still use the public Orator pages; they cannot reach operator authority without this token.
# 16+ characters, e.g. openssl rand -hex 24. If unset, a random token is generated on every start and printed
# once in the server log. In development (NODE_ENV not production) a browser on this same machine is unlocked
# automatically, and only that.
COMMANDER_COCKPIT_TOKEN=
# Hours a cockpit session lasts (1-168, default 12).
COMMANDER_SESSION_HOURS=
# Requests per minute allowed on the public visitor routes: per client, and in total. Defaults 60 and 600.
COMMANDER_STUDIO_RPM=
COMMANDER_STUDIO_GLOBAL_RPM=
# Behind a reverse proxy: how many proxy hops to trust when reading the client address. Unset = none.
COMMANDER_TRUST_PROXY=

# ---- Agent Commander engine --------------------------------------------------------------------
# Public base URL used in approval links and push cards. Must be reachable from the operator's phone.
# Default: http://localhost:<PORT>
COMMANDER_PUBLIC_URL=

# Persistence. Leave unset for an in-memory (ephemeral) instance.
COMMANDER_DATA_DIR=./data

# Secret that signs approval links (openssl rand -hex 32, 16+ characters). If unset, a random one is used and
# links die on every restart.
COMMANDER_LINK_SECRET=

# Platform admin token for tenant provisioning (openssl rand -hex 24, 16+ characters). If unset, /v1/admin/* is
# disabled. There is no default: the old published one is refused at startup.
COMMANDER_ADMIN_TOKEN=

# Push channel for staged approvals. Receives an ntfy-shaped JSON card (title, message, click, http actions).
# If unset, cards are printed to stdout.
COMMANDER_NOTIFY_WEBHOOK=
COMMANDER_NOTIFY_TOPIC=

# Optional Frontier Reasoning Interceptor Gate (Gemini). Reviews elevated/critical-step actions that the rules
# allowed, and may tighten the verdict but never loosen it. Unset = deterministic rules only.
#
# Beta key setup: this key is the OPERATOR's. It serves operator-only features (the reasoning gate and the cockpit's
# own Gemini calls, all behind the cockpit unlock). It is never used on a visitor's behalf: visitors to the open studio
# pages bring their own key, pasted in the browser, and without one they get clearly labelled demo results.
GEMINI_API_KEY=
# The model id is deployment configuration. The default is the build's own choice and has not been verified
# against the live API: set the model you actually use.
COMMANDER_GEMINI_MODEL=gemini-3.8-flash

# Optional multi-model routing for the Orator studio.
ANTHROPIC_API_KEY=

# Optional policy overrides (see policy.example.json).
COMMANDER_POLICY_FILE=

# ---- Independent witnessing --------------------------------------------------------------------
# Commander inspects the workspace and can run the operator's verification commands ITSELF, instead of trusting
# worker-reported exit codes and stdout.
#   (blank)  inspect-only: it reads files under the workspace and runs NO commands. The default.
#   off      no independent checks at all.
#   local    also runs the allowlisted commands below. This executes code on this host, against a workspace the
#            worker controls. It is NOT a sandbox. Enable it only where the workspace and Commander share a trust
#            domain; for multi-tenant use, inject an isolated runner instead.
COMMANDER_WITNESS_MODE=
# Absolute workspace root. Every witnessed path and working directory is confined to it (symlinks included).
COMMANDER_WITNESS_ROOT=
# Bare executable names witness commands may run, comma-separated. Required in local mode. Example: node,npm,pytest,git
COMMANDER_WITNESS_ALLOW=
# Tenant ids allowed to define witness checks, comma-separated, or * for every tenant. Required in local mode.
COMMANDER_WITNESS_TENANTS=
# PATH used to find those executables (the worker's own PATH is never used).
COMMANDER_WITNESS_PATH=
# Simultaneous independent runs, 1-16 (default 2). Extra runs queue briefly, then are refused.
COMMANDER_WITNESS_CONCURRENCY=
